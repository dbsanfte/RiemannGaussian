#!/usr/bin/env bash

set -euo pipefail

project_root=$(git rev-parse --show-toplevel)
cd "$project_root"

python3 scripts/numerical_certificate.py

if git grep --cached -nE '\<(sorry|admit|sorryAx)\>' -- '*.lean'; then
  echo 'Staged Lean sources contain a forbidden proof placeholder.' >&2
  exit 1
fi

if command -v lake >/dev/null 2>&1; then
  lake_command=(lake)
elif [[ -x "$project_root/../.lean/elan/bin/lake" ]]; then
  project_elan_home="$project_root/../.lean/elan"
  lake_command=(env "ELAN_HOME=$project_elan_home" \
    "$project_elan_home/bin/lake")
else
  echo 'Cannot find lake; install the pinned Lean toolchain before committing.' >&2
  exit 1
fi

echo 'pre-commit: ordinary and optional Lake configuration'
python3 scripts/test_numerical_certificate_build_config.py

echo 'pre-commit: warning-as-error Lean build'
"${lake_command[@]}" build --wfail

echo 'pre-commit: whole-project declaration lint'
"${lake_command[@]}" env lean -DwarningAsError=true scripts/LintProject.lean

echo 'pre-commit: compiled-environment integrity and dashboard freshness'
"${lake_command[@]}" env lean -DwarningAsError=true \
  scripts/GenerateProjectStatus.lean
git diff --exit-code -- docs/proof-status.json docs/proof-status.svg

echo 'pre-commit: Lean-derived theorem explorer and witnessed graph paths'
"${lake_command[@]}" env lean -DwarningAsError=true scripts/ExportTheoremGraph.lean
theorem_node="${THEOREM_NODE:-node}"
python3 scripts/build_theorem_explorer.py --check --node "$theorem_node"
"$theorem_node" scripts/check_theorem_graph.cjs
python3 scripts/build_numerical_certificate_explorer.py --check --node "$theorem_node"

echo 'pre-commit: checked zero-free formulas and evergreen comparison graph'
"${lake_command[@]}" env lean -DwarningAsError=true scripts/ExportZeroFreePlot.lean
plot_python="${ZERO_FREE_PLOT_PYTHON:-.lake/plot-venv/bin/python}"
if [[ ! -x "$plot_python" ]]; then
  echo 'Install plotting tools: python3 -m venv .lake/plot-venv' >&2
  echo 'Then: .lake/plot-venv/bin/pip install -r scripts/requirements-plots.txt' >&2
  exit 1
fi
"$plot_python" scripts/build_zero_free_plot.py --check
"${lake_command[@]}" env lean -DwarningAsError=true scripts/ExportNumericalCertificatePlot.lean
"$plot_python" scripts/build_numerical_certificate_plot.py --check

echo 'pre-commit: staged whitespace check'
git diff --cached --check

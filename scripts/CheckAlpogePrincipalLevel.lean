import AlpogePrimeWindows
import Formalism.SharpRestriction.RamificationFrobenius.TotientGaloisClasses.Window

/-! # Direct extraction of zeta from the geometric family at the trivial cyclic level -/

namespace RiemannGaussian.AlpogeWindow
noncomputable section
open Finset Formalism.HC

/-- The cyclic level generated by the character of conductor one retains only that character. -/
theorem principal_level_kept : (Level.cyc PChar.one).KEPT = {PChar.one} := by
  classical
  ext ψ
  rw [Finset.mem_singleton,Level.cyc,Level.mem_ofSub]
  constructor
  · rintro ⟨χ,_,rfl⟩
    exact (congrArg (fun χ : DirichletCharacter ℂ 1 => PChar.of χ) (DirichletCharacter.level_one χ)).trans (PChar.of_one 1)
  · rintro rfl
    exact ⟨1,Subgroup.one_mem _,PChar.of_one _⟩

/-- The weighted geometric sum has no nontrivial terms at the principal cyclic level. -/
theorem principal_level_Gm (y : ℝ) : (Level.cyc PChar.one).Gm y = Formalism.Gz y := by
  classical
  simp [Level.Gm,Level.Nt,principal_level_kept]

/-- On the positive half-line, the two normalizations used by the geometry and the
window theorem give the identical real prime sum. -/
theorem principal_level_G (y : ℝ) (hy : 0 ≤ y) : (Level.cyc PChar.one).Gm y = Deduction.G y := by
  rw [principal_level_Gm]
  unfold Formalism.Gz Deduction.G Formalism.Sz Deduction.ramp
  rw [Complex.re_sum]
  simp only [mul_one,← Complex.ofReal_mul,Complex.ofReal_re]
  congr 2
  have hsub : Icc 1 ⌊y⌋₊ ⊆ range (⌊y⌋₊+1) := fun n hn => by
    have := (mem_Icc.mp hn).2
    exact mem_range.mpr (by omega)
  rw [← sum_subset hsub (f := fun n : ℕ => ArithmeticFunction.vonMangoldt n * max (y/n-1) 0) (by
    intro n hn hn'
    have h0 : n = 0 := by simp only [mem_Icc,mem_range] at *; omega
    simp [h0])]
  apply sum_congr rfl
  intro n hn
  have hn0 : (0:ℝ) < n := by exact_mod_cast (mem_Icc.mp hn).1
  have hny := (Nat.cast_le.mpr (mem_Icc.mp hn).2).trans (Nat.floor_le hy)
  rw [max_eq_left (sub_nonneg.mpr ((one_le_div hn0).mpr hny))]

/-- The numerical windows output by the geometric argument at its one principal
level suffice for Mathlib's RH, for any single fixed window power above one. -/
theorem rh_of_principal_level_windows {la : ℝ} (hla : 1 < la)
    (hw : ∀ θ : ℝ, 1/2 < θ → θ < 1 →
      HasWindows {x : ℝ | (Level.cyc PChar.one).Gm x ≤ x^θ} la) : RiemannHypothesis := by
  apply rh_of_smoothed_prime_windows
  intro θ hθ ht
  refine ⟨la-1,1,by linarith,fun Y₀ => ?_⟩
  obtain ⟨Y,hY,hy⟩ := hw θ hθ ht (max 1 Y₀)
  refine ⟨Y,(le_max_right _ _).trans hY,fun y h => ?_⟩
  have hpos := (zero_le_one.trans (le_max_left 1 Y₀)).trans (hY.trans h.1)
  rw [one_mul,← principal_level_G y hpos]
  apply hy y h.1
  simpa only [show (1:ℝ)+(la-1)=la by ring] using h.2

end
end RiemannGaussian.AlpogeWindow

open Lean Elab Command in
run_cmd do
  for decl in [``RiemannGaussian.AlpogeWindow.principal_level_kept,
      ``RiemannGaussian.AlpogeWindow.principal_level_G,
      ``RiemannGaussian.AlpogeWindow.rh_of_principal_level_windows] do
    let axs ← Lean.collectAxioms decl
    for ax in axs do
      unless [``propext,``Classical.choice,``Quot.sound].contains ax do
        throwError "Unexpected axiom {ax} in {decl}"
    logInfo m!"{decl} depends on {axs}"

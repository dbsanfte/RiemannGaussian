import RiemannGaussian.SemiprimeD1BinaryPublicAcquisitionBounds
import RiemannGaussian.SemiprimeD1StackProductCheckMeaning

/-! # Original binary-input public product checker
Public acquisition runs ONCE and its actual modulus is shared directly with the
whole raw product checker. Only original binary N and the actual raw assignment
are initially present. Assignment generation remains the enclosing table
producer's work; no metadata, width, vector, operand, guard or verdict is input.
-/
set_option autoImplicit false
set_option synthInstance.maxSize 4096
set_option Elab.async false
namespace RiemannGaussian.SemiprimeD1StackPublicProduct
namespace C
export SemiprimeD1StackCalls (Instruction State execute step run)
end C
namespace P
export SemiprimeD1BinaryPublicAcquisition (Stack Label program input initial digitStack fermatStack)
end P
namespace V
export SemiprimeD1StackProductCheck (Stack Label program input initial rawInput modulus output)
end V
/-- All76 fixed Boolean roles, including the unused private modulus shadow. -/
abbrev Stack := P.Stack⊕V.Stack
/-- The ACTUAL acquired binary modulus, never an initialized value/size answer. -/
def modulusKey : P.Stack := P.fermatStack (.inr false)
/-- Physical checker registers share the one actual public modulus cache. -/
def checkStack (k : V.Stack) : Stack := if k=V.modulus then .inl modulusKey else .inr k
/-- The original binary source input designation. -/
def original : Stack := .inl (P.digitStack (SemiprimeD1BinaryPublicAcquisition.Digits.metaStack .input))
/-- Actual complete raw assignment tape, generated by the eventual table caller. -/
def assignment : Stack := checkStack V.rawInput
/-- Physical singleton Boolean output. -/
def output : Stack := checkStack V.output
/-- Fixed finite labels, with no original-number/assignment/evaluator payload. -/
inductive Label where
  | start | check | done | acquire (pc : P.Label) | product (pc : V.Label)
  deriving Fintype
/-- One literal source program including every metadata and checker procedure. -/
def program : Label→C.Instruction Stack Label
  | .start=>.call (.acquire (SemiprimeD1BinaryPublicAcquisition.mainLabel .start)) .check
  | .check=>.call (.product .start) .done
  | .done=>.base .halt
  | .acquire pc=>SemiprimeD1StackValidationLink.instruction Sum.inl Label.acquire (P.program pc)
  | .product pc=>SemiprimeD1StackValidationLink.instruction checkStack Label.product (V.program pc)
/-- Only the original N and raw assignment occupy initial physical input cells. -/
def input (bits raw : List Bool) : Stack→List Bool := Sum.elim (P.input bits) (V.input raw [])
/-- Actual source entry before any public acquisition or operand preparation. -/
def initial (bits raw : List Bool) : C.State Stack Label := ⟨some .start,none,none,input bits raw,[]⟩
/-- Sharing does not identify two checker roles. -/
theorem checkStack_injective : Function.Injective checkStack := by
  intro i j h
  by_cases hi:i=V.modulus
  · subst i
    by_cases hj:j=V.modulus
    · exact hj.symm
    · simp only [checkStack,ite_true,hj,ite_false] at h
      cases h
  · by_cases hj:j=V.modulus
    · subst j
      simp only [checkStack,hi,ite_false,ite_true] at h
      cases h
    · simpa only [checkStack,hi,hj,ite_false,Sum.inr.injEq] using h
/-- Genuine fixed finite machine; extra assignment input is explicit in initial. -/
def machine : Turing.FinTM2 := SemiprimeD1StackCalls.machine original output .start program
/-- Every data/return alphabet is fixed and finite before all original inputs. -/
theorem all_alphabets_finite : ∀k,Finite (machine.Γ k) :=
  SemiprimeD1StackCalls.all_alphabets_finite original output Label.start program
/-- No decoded input value, result, expression or elapsed count enters control. -/
theorem control_finite : Finite machine.σ := SemiprimeD1StackCalls.control_finite original output Label.start program
/-- Complete physical data role inventory, including every unused shadow. -/
theorem stack_card : Fintype.card Stack=76 := by decide
end RiemannGaussian.SemiprimeD1StackPublicProduct

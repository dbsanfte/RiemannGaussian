  simp only [blocks, List.mem_cons, List.not_mem_nil, or_false] at ha
  rcases ha with rfl | rfl | rfl | rfl
  · exact block00_valid
  · exact block01_valid
  · exact block02_valid
  · exact block03_valid

end RiemannGaussian.MontgomeryTaylorAnchorBounds.CertificateData.Group04

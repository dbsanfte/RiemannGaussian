/-- Fixed-point phase coordinates for indices zero through 15999. -/
def cycle : List (ℤ × ℤ) :=
  part00 ++ part01 ++ part02 ++ part03 ++ part04 ++ part05 ++ part06 ++ part07 ++ part08 ++ part09 ++ part10 ++ part11 ++ part12 ++ part13 ++ part14 ++ part15

/-- Uniform phase blocks for short indexed lookups. -/
def blocks : List (List (ℤ × ℤ)) := [part00, part01, part02, part03, part04, part05, part06, part07, part08, part09, part10, part11, part12, part13, part14, part15]


/-- The stored cycle has the exact required number of entries. -/
theorem cycle_length : cycle.length = 16000 := by
  norm_num only [cycle, List.length_append, part00_length, part01_length, part02_length, part03_length, part04_length, part05_length, part06_length, part07_length, part08_length, part09_length, part10_length, part11_length, part12_length, part13_length, part14_length, part15_length]

/-- The initial rotation is exactly the unit point. -/
theorem cycle_start : cycle[0]?.getD (0, 0) = ((scale : ℤ), 0) := by decide +kernel

/-- All coordinate bounds and adjacent recurrence residuals are checked
by the Lean kernel. -/
theorem cycle_checked : checkEdges cycle = true :=
  checkEdges_append part00_checked (checkEdges_append part01_checked (checkEdges_append part02_checked (checkEdges_append part03_checked (checkEdges_append part04_checked (checkEdges_append part05_checked (checkEdges_append part06_checked (checkEdges_append part07_checked (checkEdges_append part08_checked (checkEdges_append part09_checked (checkEdges_append part10_checked (checkEdges_append part11_checked (checkEdges_append part12_checked (checkEdges_append part13_checked (checkEdges_append part14_checked (part15_checked) (by decide +kernel)) (by decide +kernel)) (by decide +kernel)) (by decide +kernel)) (by decide +kernel)) (by decide +kernel)) (by decide +kernel)) (by decide +kernel)) (by decide +kernel)) (by decide +kernel)) (by decide +kernel)) (by decide +kernel)) (by decide +kernel)) (by decide +kernel)) (by decide +kernel)

/-- The block representation is exactly the checked flat cycle. -/
theorem blocks_flatten : blocks.flatten = cycle := by
  simp only [blocks, cycle, List.flatten_cons, List.flatten_nil, List.append_nil, List.append_assoc]

/-- Every stored block has the same exact length. -/
theorem blocks_uniform : ∀ b ∈ blocks, b.length = 1000 := by
  simp only [blocks, List.mem_cons, List.not_mem_nil, or_false]
  intro b hb
  rcases hb with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact part00_length
  · exact part01_length
  · exact part02_length
  · exact part03_length
  · exact part04_length
  · exact part05_length
  · exact part06_length
  · exact part07_length

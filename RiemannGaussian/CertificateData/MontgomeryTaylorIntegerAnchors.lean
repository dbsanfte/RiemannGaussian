def blocks : List (List Anchor) := [block00, block01, block02, block03, block04, block05, block06, block07, block08, block09, block10, block11, block12, block13, block14, block15, block16, block17, block18, block19, block20, block21, block22, block23, block24, block25, block26, block27, block28, block29]

/-- Every stored cache retains its independent real analytic proof. -/
theorem blocks_valid : ∀ block ∈ blocks, ∀ a ∈ block,
    MontgomeryTaylorAnchorBounds.Valid a.decode := by
  intro block hb
  simp only [blocks, List.mem_cons, List.not_mem_nil, or_false] at hb
  rcases hb with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact block00_valid
  · exact block01_valid
  · exact block02_valid
  · exact block03_valid
  · exact block04_valid
  · exact block05_valid
  · exact block06_valid
  · exact block07_valid
  · exact block08_valid
  · exact block09_valid
  · exact block10_valid
  · exact block11_valid
  · exact block12_valid
  · exact block13_valid
  · exact block14_valid
  · exact block15_valid
  · exact block16_valid
  · exact block17_valid
  · exact block18_valid
  · exact block19_valid
  · exact block20_valid
  · exact block21_valid
  · exact block22_valid
  · exact block23_valid
  · exact block24_valid
  · exact block25_valid
  · exact block26_valid
  · exact block27_valid
  · exact block28_valid
  · exact block29_valid

/-- Fast indexed access to the complete integer catalogue. -/
def lookup (i : ℕ) : Option Anchor := catalogueLookup blocks i

/-- Every successful integer lookup carries the original real bounds. -/
theorem lookup_valid (i : ℕ) (a : Anchor) (h : lookup i = some a) :
    MontgomeryTaylorAnchorBounds.Valid a.decode :=
  catalogueLookup_valid blocks blocks_valid h

end RiemannGaussian.MontgomeryTaylorIntegerBoxCertificate.CertificateData

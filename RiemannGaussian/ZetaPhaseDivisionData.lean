/-- Every rational synthetic-division recurrence has residual at most
`10⁻²⁵`. Both successor coefficients are retained in the identity. -/
theorem phaseContactDivisionCenterQ_residual (i : Fin 3) (j : Fin 8) (k : Fin 25) :
    |phaseContactDivisionCenterQ i ⟨j.val + 1, by omega⟩ k.val -
      phaseContactDivisionCenterQ i ⟨j.val, by omega⟩ (k.val + 1) -
      phaseContactRootCenterQ ⟨j.val / 2, by omega⟩ *
        phaseContactDivisionCenterQ i ⟨j.val + 1, by omega⟩ (k.val + 1)| ≤ (1 / 10 ^ 25 : ℚ) := by
  fin_cases i <;> fin_cases j <;> fin_cases k <;>
    norm_num [phaseContactDivisionCenterQ, phaseContactRootCenterQ,
      divisionRowQ0_0, divisionRowQ0_1, divisionRowQ0_2, divisionRowQ0_3, divisionRowQ0_4,
      divisionRowQ0_5, divisionRowQ0_6, divisionRowQ0_7, divisionRowQ0_8, divisionRowQ1_0,
      divisionRowQ1_1, divisionRowQ1_2, divisionRowQ1_3, divisionRowQ1_4, divisionRowQ1_5,
      divisionRowQ1_6, divisionRowQ1_7, divisionRowQ1_8, divisionRowQ2_0, divisionRowQ2_1,
      divisionRowQ2_2, divisionRowQ2_3, divisionRowQ2_4, divisionRowQ2_5, divisionRowQ2_6,
      divisionRowQ2_7, divisionRowQ2_8]

/-- Each central quotient has zero coefficient at degree 24. -/

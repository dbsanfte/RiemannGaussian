    phaseContactDivisionCenterQ i ⟨j.val + 1, by omega⟩ 24 = 0 := by
  fin_cases i <;> fin_cases j <;> norm_num [phaseContactDivisionCenterQ,
      divisionRowQ0_0, divisionRowQ0_1, divisionRowQ0_2, divisionRowQ0_3, divisionRowQ0_4,

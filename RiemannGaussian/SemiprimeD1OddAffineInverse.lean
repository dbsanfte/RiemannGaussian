import RiemannGaussian.SemiprimeD1CrossingPaper

/-! # Executed finite odd-affine inverses for the original D.12 kernel
The runtime list is generated by the finite geometric formula, using an actual
odd constant inverse in ZMod. Its polynomial interpretation is proof-only.
Even slopes are nilpotent modulo 2^p, so evaluation is valid in every algebra,
including the paper's unramified extension, without an extension inverse oracle.
-/
set_option autoImplicit false
namespace RiemannGaussian.SemiprimeD1OddAffineInverse
open scoped BigOperators
open Polynomial SemiprimeD1WireKernelOriginal

/-- Acquired inverse coefficients, in ascending degree, with no coefficient input. -/
def coefficients (p : ℕ) (constant slope : ℤ) : List (ZMod (2^p)) :=
  (List.range p).map (fun r => (constant:ZMod (2^p))⁻¹*
    (-(slope:ZMod (2^p))*(constant:ZMod (2^p))⁻¹)^r)

/-- Exact finite polynomial interpreted from the explicitly acquired coefficient list. -/
noncomputable def inverse (p : ℕ) (constant slope : ℤ) : (ZMod (2^p))[X] :=
  C ((constant:ZMod (2^p))⁻¹)*
    ∑ r∈Finset.range p,(-(C (slope:ZMod (2^p))*C ((constant:ZMod (2^p))⁻¹)*X))^r

/-- The executed list has precisely p entries. -/
theorem coefficients_length (p : ℕ) (constant slope : ℤ) :
    (coefficients p constant slope).length=p := by simp [coefficients]

/-- Every executed coefficient is the genuine finite inverse coefficient. -/
theorem coefficients_get (p : ℕ) (constant slope : ℤ) (r : Fin p) :
    (coefficients p constant slope)[r.val]'(by simp [coefficients])=
      (constant:ZMod (2^p))⁻¹*(-(slope:ZMod (2^p))*(constant:ZMod (2^p))⁻¹)^r.val := by
  simp [coefficients]

/-- Polynomial interpretation of the acquired inverse list is the stated finite inverse. -/
theorem inverse_from_coefficients (p : ℕ) (constant slope : ℤ) :
    inverse p constant slope=∑ r∈Finset.range p,
      C ((coefficients p constant slope)[r]?.getD 0)*X^r := by
  unfold inverse
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro r hr
  have hl : r<p := Finset.mem_range.mp hr
  have hc : (coefficients p constant slope)[r]?.getD 0=
      (constant:ZMod (2^p))⁻¹*(-(slope:ZMod (2^p))*(constant:ZMod (2^p))⁻¹)^r := by
    simp [coefficients,hl]
  rw [hc]
  simp only [C_mul,C_pow,map_neg,neg_mul]
  ring

/-- An actually even integer slope has p-th power zero modulo 2^p. -/
theorem even_slope_nilpotent (p : ℕ) (slope : ℤ) (hs : Even slope) :
    (slope:ZMod (2^p))^p=0 := by
  obtain ⟨u,hu⟩ := even_iff_two_dvd.mp hs
  rw [hu,Int.cast_mul,mul_pow]
  have h : (2:ZMod (2^p))^p=0 := by
    simpa only [Nat.cast_pow,Nat.cast_ofNat] using ZMod.natCast_self (2^p)
  rw [Int.cast_ofNat,h,zero_mul]

/-- The original finite geometric inverse is a true polynomial inverse, not just
an inverse after substituting an integer scalar. -/
theorem inverse_correct (p : ℕ) (constant slope : ℤ) (hc : Odd constant)
    (hs : Even slope) :
    (C (constant:ZMod (2^p))+C (slope:ZMod (2^p))*X)*inverse p constant slope=1 := by
  let e : (ZMod (2^p))[X] := C (slope:ZMod (2^p))*C ((constant:ZMod (2^p))⁻¹)*X
  have hi := ZMod.mul_inv_of_unit (constant:ZMod (2^p)) (odd_unit constant hc p)
  have he : e^p=0 := by
    dsimp [e]
    rw [mul_pow,mul_pow,← C_pow,even_slope_nilpotent p slope hs,C_0,zero_mul,zero_mul]
  have hneg : (-e)^p=0 := by rw [neg_pow,he,mul_zero]
  have hg := geom_sum_mul_neg (-e) p
  rw [hneg,sub_zero] at hg
  have hfac : C (constant:ZMod (2^p))+C (slope:ZMod (2^p))*X=
      C (constant:ZMod (2^p))*(1+e) := by
    dsimp [e]
    have hci : C (constant:ZMod (2^p))*C ((constant:ZMod (2^p))⁻¹)=1 := by
      rw [← C_mul,hi,C_1]
    calc
      _ = C (constant:ZMod (2^p))+C (slope:ZMod (2^p))*X*
        (C (constant:ZMod (2^p))*C ((constant:ZMod (2^p))⁻¹)) := by rw [hci,mul_one]
      _ = _ := by ring
  unfold inverse
  change (C (constant:ZMod (2^p))+C (slope:ZMod (2^p))*X)*
    (C ((constant:ZMod (2^p))⁻¹)*∑ r∈Finset.range p,(-e)^r)=1
  rw [hfac]
  calc
    _ = (C (constant:ZMod (2^p))*C ((constant:ZMod (2^p))⁻¹))*
      ((∑ r∈Finset.range p,(-e)^r)*(1-(-e))) := by ring
    _ = 1 := by rw [← C_mul,hi,C_1,hg,one_mul]

/-- The finite construction is a unit before any extension scalar is supplied. -/
theorem affine_isUnit (p : ℕ) (constant slope : ℤ) (hc : Odd constant)
    (hs : Even slope) : IsUnit (C (constant:ZMod (2^p))+C (slope:ZMod (2^p))*X) := by
  exact ⟨⟨_,inverse p constant slope,inverse_correct p constant slope hc hs,
    by rw [mul_comm];exact inverse_correct p constant slope hc hs⟩,rfl⟩

/-- Every algebra evaluation preserves the acquired inverse identity. -/
theorem evaluated_inverse {A : Type*} [CommRing A] (p : ℕ)
    (f : ZMod (2^p) →+* A) (z : A) (constant slope : ℤ)
    (hc : Odd constant) (hs : Even slope) :
    (f (constant:ZMod (2^p))+f (slope:ZMod (2^p))*z)*
      (inverse p constant slope).eval₂ f z=1 := by
  have h := congrArg (Polynomial.eval₂ f z) (inverse_correct p constant slope hc hs)
  simpa only [Polynomial.eval₂_mul,Polynomial.eval₂_add,Polynomial.eval₂_C,
    Polynomial.eval₂_X,Polynomial.eval₂_one] using h

end RiemannGaussian.SemiprimeD1OddAffineInverse

import RiemannGaussian.SemiprimeD1StackOrdinalBankMoves
import RiemannGaussian.SemiprimeD1OrdinalBankSpec
/-! # Exactly tally-length real counter rounds, not complete binary enumeration -/
set_option autoImplicit false
set_option maxHeartbeats 2500000
set_option maxRecDepth 32768
namespace RiemannGaussian.SemiprimeD1StackOrdinalBankLoop
open SemiprimeD1StackOrdinalBank SemiprimeD1StackOrdinalBankCalls SemiprimeD1StackOrdinalBankMoves
open SemiprimeD1StackProcedureFragments (Runs one_base)
open SemiprimeD1StackAssignmentOrder (assignments)
open SemiprimeSourceHistogramKeyBits (frame)
open SemiprimeD1TensorTapeCodec (vectorBits)

/-- Actual loop time bound depends only on remaining physical markers, current
counter width and actual log inventory; no body/iteration-cost oracle. -/
def loopBudget (todo word history : List Bool) : ℕ :=
  100*(todo.length+1)*(word.length+1)+2*history.length+10

/-- Whole actual marker-controlled loop. Each remaining marker invokes the
literal logger and binary incrementer once. Zero markers performs zero rounds. -/
theorem loop_run (todo word history output tally : List Bool) :
    ∃ m≤loopBudget todo word history,
      Runs program m (.inl .loop) (data word [] [] history output tally todo [] []) (.inl .done)
        (data [] [] [] [] ((history.reverse++vectorBits (assignments todo.length word))++output) tally [] [] []) := by
  induction todo generalizing word history with
  | nil =>
    have h0 : Runs program 1 (.inl .loop) (data word [] [] history output tally [] [] [])
        (.inl .clearCounter) (data word [] [] history output tally [] [] []) := by
      apply one_base program _ _ (.pop remaining (.inl .clearCounter) (.inl .bodyCall) (.inl .bodyCall)) _ _ rfl
      · rfl
      · funext k; rcases k with k|k <;> cases k <;>
          simp [SemiprimeD1StackBytecode.execute,data,SemiprimeD1StackAssignmentLoop.data,remaining]
    have h1:=finish_run word history output tally
    refine ⟨1+(word.length+2*history.length+5),?_,?_⟩
    · unfold loopBudget
      simp only [List.length_nil]
      nlinarith
    · simpa only [List.length_nil,assignments,vectorBits,List.append_assoc,List.singleton_append] using h0.trans h1
  | cons bit todo ih =>
    let logged:=(true::frame word []).reverse++history
    have h0 : Runs program 1 (.inl .loop) (data word [] [] history output tally (bit::todo) [] [])
        (.inl .bodyCall) (data word [] [] history output tally todo [] []) := by
      apply one_base program _ _ (.pop remaining (.inl .clearCounter) (.inl .bodyCall) (.inl .bodyCall)) _ _ rfl
      · cases bit <;> rfl
      · cases bit <;> funext k <;> rcases k with k|k <;> cases k <;> rfl
    obtain ⟨mb,hmb,hbody⟩:=body_call word history output tally todo
    obtain ⟨mi,hmi,hinc⟩:=increment_call word logged output tally todo
    have hcontinue:=continue_run (SemiprimeD1StackIncrement.overflow word)
      (SemiprimeD1StackIncrement.wrapped word) logged output tally todo
    obtain ⟨mr,hmr,hrest⟩:=ih (SemiprimeD1StackIncrement.wrapped word) logged
    have hh:=h0.trans (hbody.trans (hinc.trans (hcontinue.trans hrest)))
    refine ⟨1+(mb+(mi+((4*(SemiprimeD1StackIncrement.wrapped word).length+3)+mr))),?_,?_⟩
    · unfold loopBudget at hmr ⊢
      simp only [SemiprimeD1StackIncrement.wrapped_length,List.length_cons] at hmr ⊢
      dsimp only [logged] at hmr
      simp only [List.length_append,List.length_reverse,List.length_cons,
        SemiprimeSourceHistogramKeyBits.frame_length,List.length_nil] at hmr
      nlinarith
    · have hl:=SemiprimeD1StackAssignmentEnumeration.log_cons word history output
        (assignments todo.length (SemiprimeD1StackIncrement.wrapped word))
      simpa only [List.length_cons,assignments,logged,hl] using hh

/-- Exact output words are generated by the actual first tally-length increments. -/
def done (tally : List Bool) : C.State Stack Label :=
  ⟨none,none,none,data [] [] [] [] (vectorBits (SemiprimeD1OrdinalBankSpec.words tally.length)) tally [] [] [],[]⟩
/-- Closed reusable ready supplier from its ACTUAL unary tally cache only. It
preserves that cache; no M, ID array, iterator count, width or cost is supplied. -/
theorem source_run (tally : List Bool) :
    ∃ m≤1000*(tally.length+1)^2,C.run program m (initial tally)=some (done tally) := by
  have h0:=copy_zero tally
  have h1:=zero_run tally [] tally
  simp only [List.append_nil] at h1
  have h2:=copy_remaining tally (List.replicate tally.length false)
  obtain ⟨ml,hml,h3⟩:=loop_run tally (List.replicate tally.length false) [] [] tally
  have hh:=h0.trans (h1.trans (h2.trans h3))
  obtain ⟨finish,hfinish,hAt⟩:=hh [] (initial tally) ⟨rfl,rfl,rfl⟩
  refine ⟨(5*tally.length+4)+((2*tally.length+1)+((5*tally.length+4)+ml))+1,?_,?_⟩
  · unfold loopBudget at hml
    simp only [List.length_replicate,List.length_nil] at hml
    nlinarith
  · rw [SemiprimeD1StackReturnLink.run_add,hfinish,Option.bind_some]
    rcases hAt with ⟨hpc,hd,hframes⟩
    change C.step program finish=some (done tally)
    simp [C.step,SemiprimeD1StackCalls.step,hpc,program,C.execute,SemiprimeD1StackCalls.execute,
      hd,hframes,done,SemiprimeD1OrdinalBankSpec.words]

end RiemannGaussian.SemiprimeD1StackOrdinalBankLoop

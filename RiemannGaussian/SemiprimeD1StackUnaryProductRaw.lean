import RiemannGaussian.SemiprimeD1StackUnaryProduct

/-! # Actual product of physical counter lengths with arbitrary marker bits
This successor proves an additional trace of the SAME frozen literal program.
Both zero and one payload bits are counter cells. No normalized unary input,
decoded length, product or work answer is supplied to the executing program.
-/
set_option autoImplicit false
set_option Elab.async false
set_option maxHeartbeats 900000
namespace RiemannGaussian.SemiprimeD1StackUnaryProductRaw
open SemiprimeD1StackUnaryProduct
open SemiprimeD1StackUnaryDivmod (unary unary_add)
open SemiprimeD1StackFiniteControlPaths (SourcePath)

/-- Every actual multiplier cell triggers the same real preserving copy,
irrespective of its payload bit. -/
theorem product_exec (m d : List Bool) (product : List Bool) (flag : Option Bool) :
    Executes (m.length*(2*d.length+3)+1) (cfg (some .loop) flag m d [] product)
      (cfg none none [] d [] (unary (m.length*d.length)++product)) := by
  induction m generalizing flag product with
  | nil =>
    simp only [List.length_nil,Nat.zero_mul,show unary 0=[] from rfl,List.nil_append]
    apply SourcePath.next ?_ (.refl _)
    simp [program,cfg,contents,Turing.TM2.step,Turing.TM2.stepAux]
  | cons b m ih =>
    have hs : Turing.TM2.step program (cfg (some .loop) flag (b::m) d [] product)=
        some (cfg (some .drain) (some b) m d [] product) := by
      cases b <;> simp [program,cfg,contents,Turing.TM2.step,Turing.TM2.stepAux]
    have hc:=copy_exec (some b) m d product
    have ht:=ih (unary d.length++product) none
    have h:=SourcePath.next hs (exec_trans hc ht)
    have he : 2*d.length+2+(m.length*(2*d.length+3)+1)+1=
        (m.length+1)*(2*d.length+3)+1 := by ring
    rw [he] at h
    simpa only [List.length_cons,Nat.add_mul,Nat.one_mul,unary_add,List.append_assoc] using h

/-- The frozen generated bytecode actually acquires the product of physical
counter lengths, retaining the exact arbitrary multiplicand bytes. -/
theorem product_run (m d : List Bool) :
    ∃t≤5*(m.length*(2*d.length+3)+1),SemiprimeD1StackBytecode.run code t
      ⟨some entry,none,contents m d [] []⟩=
      some ⟨none,none,contents [] d [] (unary (m.length*d.length))⟩ := by
  obtain ⟨t,ht,flag,he⟩:=SemiprimeD1StackFiniteControlPaths.path_refines program 5 program_depth
    (product_exec m d [] none) none
  exact ⟨t,ht,by simpa [List.append_nil,SemiprimeD1StackFiniteControlExecution.destination,cfg,code,entry]
    using SemiprimeD1StackFiniteControlPaths.Executes.iterates he⟩
end RiemannGaussian.SemiprimeD1StackUnaryProductRaw

import RiemannGaussian.ArithmeticOperatorBinaryPrimeControl
import Mathlib.NumberTheory.EulerProduct.DirichletLSeries

/-!
# A genuine unit-prime Euler-product control

The binary rounding control is a subset of the ordinary integer primes,
not just a fractional positive measure. Its multiplicative monoid has a
convergent Euler product on Re(s)>1 and its full Mangoldt coefficient
retains every power of every selected prime. Its factorial source is -2.
This rejects support/positivity/Euler-product-only non-coherence claims;
the control is NOT the unaltered Mangoldt sequence and cannot satisfy
all exact actual Gamma observations.
-/

namespace RiemannGaussian.ArithmeticOperatorBinaryEulerControl
noncomputable section
open Complex Filter Topology
open scoped BigOperators Classical
open ArithmeticOperatorBinaryPrimeControl ArithmeticOperatorPrimeTowerControl

/-- Monoid of positive integers generated by the retained ordinary primes. -/
def kept (u y : ℝ) (n : ℕ) : Prop :=
  n≠0 ∧ ∀ p : ℕ, p.Prime → p∣n → removedBase u y p=0

/-- Literal integer factorization, not a free generalized-prime premise. -/
theorem kept_mul_iff (u y : ℝ) (m n : ℕ) :
    kept u y (m*n) ↔ kept u y m ∧ kept u y n := by
  constructor
  · intro hh
    constructor
    · refine ⟨left_ne_zero_of_mul hh.1,?_⟩
      intro p hp hpm
      exact hh.2 p hp (dvd_mul_of_dvd_left hpm n)
    · refine ⟨right_ne_zero_of_mul hh.1,?_⟩
      intro p hp hpn
      exact hh.2 p hp (dvd_mul_of_dvd_right hpn m)
  · rintro ⟨hm,hn⟩
    refine ⟨mul_ne_zero hm.1 hn.1,?_⟩
    intro p hp hpn
    rcases hp.dvd_mul.mp hpn with hh | hh
    · exact hm.2 p hp hh
    · exact hn.2 p hp hh

/-- No prime is lost or gained at the unit endpoint. -/
theorem kept_one (u y : ℝ) : kept u y 1 := by
  refine ⟨by norm_num,?_⟩
  intro p hp hh
  exact False.elim (hp.not_dvd_one hh)

/-- Exact membership at an ordinary-prime label. -/
theorem kept_prime (u y : ℝ) {p : ℕ} (hp : p.Prime) :
    kept u y p ↔ removedBase u y p=0 := by
  constructor
  · exact fun hh => hh.2 p hp dvd_rfl
  · intro hh
    refine ⟨hp.ne_zero,?_⟩
    intro q hq hqp
    rcases (Nat.dvd_prime hp).mp hqp with hq1 | hqp'
    · exact False.elim (hq.ne_one hq1)
    · simpa only [hqp'] using hh

/-- Completely multiplicative zero-one indicator of the selected monoid. -/
def indicatorHom (u y : ℝ) : ℕ →*₀ ℂ where
  toFun n := if kept u y n then 1 else 0
  map_zero' := by simp [kept]
  map_one' := by simp [kept_one]
  map_mul' m n := by
    simp only [kept_mul_iff]
    by_cases hm : kept u y m <;> by_cases hn : kept u y n <;> simp [hm,hn]

/-- The homomorphism's prime value is precisely the retained unit weight. -/
theorem indicator_prime (u y : ℝ) {p : ℕ} (hp : p.Prime) :
    indicatorHom u y p = (retainedBase u y p : ℂ) := by
  change (if kept u y p then (1 : ℂ) else 0) = _
  rw [kept_prime u y hp]
  rcases removedBase_binary u y p with hh | hh <;>
    norm_num [retainedBase,hh]

/-- Euler summand of the genuinely selected integer-prime system. -/
def summandHom (u y : ℝ) {s : ℂ} (hs : s≠0) : ℕ →*₀ ℂ :=
  { toFun := fun n => indicatorHom u y n*riemannZetaSummandHom hs n
    map_zero' := by simp
    map_one' := by simp
    map_mul' := fun m n => by simp only [map_mul]; ring }

/-- Absolute convergence is inherited from the ordinary integer series. -/
theorem summable_norm_summand (u y : ℝ) {s : ℂ} (hs : 1<s.re) :
    Summable (fun n => ‖summandHom u y (ne_zero_of_one_lt_re hs) n‖) := by
  apply (summable_riemannZetaSummand hs).of_nonneg_of_le (fun _ => norm_nonneg _)
  intro n
  change ‖(if kept u y n then (1 : ℂ) else 0)*riemannZetaSummandHom _ n‖ ≤ _
  split_ifs <;> simp

/-- Genuine convergent Euler product with UNIT ordinary-prime factors;
this is no longer merely a finite or fractionally weighted control. -/
theorem hasProd_selected_primes (u y : ℝ) {s : ℂ} (hs : 1<s.re) :
    HasProd (fun p : Nat.Primes =>
      (1-(retainedBase u y p : ℂ)*(p : ℂ)^(-s))⁻¹)
      (∑' n, summandHom u y (ne_zero_of_one_lt_re hs) n) := by
  have hh := EulerProduct.eulerProduct_completely_multiplicative_hasProd
    (summable_norm_summand u y hs)
  convert hh using 1
  funext p
  change (1-(retainedBase u y p : ℂ)*(p : ℂ)^(-s))⁻¹ =
    (1-indicatorHom u y p*riemannZetaSummandHom _ p)⁻¹
  rw [indicator_prime u y p.prop]
  rfl

/-- The coefficient retains ALL powers with the SAME unit prime weight. -/
theorem coefficient_eq_indicator_mangoldt (u y : ℝ) (n : ℕ) :
    (towerCoefficient (retainedBase u y) n : ℂ) =
      indicatorHom u y n*(ArithmeticFunction.vonMangoldt n : ℂ) := by
  by_cases hn : IsPrimePow n
  · obtain ⟨p,k,hp,hk,hn'⟩ := (isPrimePow_nat_iff n).mp hn
    rw [←hn',towerCoefficient_pow _ hp hk,map_pow,indicator_prime u y hp,
      ArithmeticFunction.vonMangoldt_apply_pow hk.ne',ArithmeticFunction.vonMangoldt_apply_prime hp,
      Complex.ofReal_mul]
    rcases removedBase_binary u y p with hh | hh <;>
      simp [retainedBase,hh,hk.ne']
  · simp [towerCoefficient_not_primePow _ hn,ArithmeticFunction.vonMangoldt_eq_zero_iff.mpr hn]

/-- The UNIT-prime Euler-product control has the complete -2 factorial
source with every proper power retained, without any zeta-zero premise. -/
theorem euler_control_source :
    Tendsto (fun k : ℕ => ((10001/20000 : ℝ) : ℂ)^(k+1)*∑' n,
      indicatorHom (10001/20000) 54 n*(ArithmeticFunction.vonMangoldt n : ℂ)*
        zetaPrimeLogKernel k (3/2+Complex.I*54) n) atTop (𝓝 (-2)) := by
  have hh := ArithmeticOperatorBinaryPrimeControl.fullMoment_target_tendsto
  apply hh.congr
  intro k
  unfold fullMoment
  apply congrArg (((10001/20000 : ℝ) : ℂ)^(k+1)*·)
  apply tsum_congr
  intro n
  rw [coefficient_eq_indicator_mangoldt]
  norm_num

/-- At least one genuine ordinary prime is deleted; source retention is
not just a rephrasing of the original actual-prime array. -/
theorem exists_deleted_prime :
    ∃ p : ℕ, p.Prime ∧ removedBase (10001/20000) 54 p=1 := by
  by_contra hh
  push Not at hh
  have hp0 (p : ℕ) (hp : p.Prime) : removedBase (10001/20000) 54 p=0 :=
    (removedBase_binary (10001/20000) 54 p).resolve_right (hh p hp)
  have he (k : ℕ) : ordinaryMoment (removedBase (10001/20000) 54) (10001/20000) 54 k=0 := by
    unfold ordinaryMoment
    apply mul_eq_zero_of_right
    calc
      _ = ∑' _ : ℕ, (0 : ℂ) := by
        apply tsum_congr
        intro p
        by_cases hp : p.Prime
        · simp [hp,towerCoefficient,hp0 p hp]
        · simp [hp]
      _ = 0 := tsum_zero
  have ht := (removedMoment_tendsto (10001/20000) 54
    (by norm_num) (by norm_num) (by norm_num)).congr he
  have hbad := tendsto_nhds_unique (f := fun _ : ℕ => (0 : ℂ)) tendsto_const_nhds ht
  norm_num at hbad

/-- Free feature Gram positivity still holds for this unit-prime Euler
system, so it cannot by itself remove the coherent source. -/
theorem control_free_Gram_nonnegative {ι : Type*} (S : Finset ι) (D : Finset ℕ)
    (alpha : ι → ℂ) (feature : ι → ℕ → ℂ) (u y : ℝ) :
    0 ≤ (ArithmeticOperatorGramAudit.joinedGram S D alpha feature
      (fun n => (towerCoefficient (retainedBase u y) n : ℂ))).re :=
  ArithmeticOperatorGramAudit.joinedGram_nonnegative_for_arbitrary_weights S D alpha feature
    (towerCoefficient (retainedBase u y)) (fun n _ =>
      (towerCoefficient_bounds _ (fun p => (binaryBase_bounds u y p).2) n).1)

/-- Every exact integer Gamma upper bound is respected, with all
prime powers retained. Equality of every prefix is additional data. -/
theorem control_factorialPrefix_le (u y : ℝ) (N : ℕ) :
    (ArithmeticOperatorFactorialUniqueness.factorialPrefix
      (fun n => (towerCoefficient (retainedBase u y) n : ℂ)) N).re ≤
      Real.log (N.factorial : ℝ) := by
  have he := congrArg Complex.re (ArithmeticOperatorFactorialUniqueness.factorialPrefix_mangoldt N)
  simp only [ArithmeticOperatorFactorialUniqueness.factorialPrefix,Complex.re_sum,
    Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,Complex.natCast_re,
    Complex.natCast_im,mul_zero,sub_zero] at he ⊢
  rw [←he]
  apply Finset.sum_le_sum
  intro n _
  exact mul_le_mul_of_nonneg_left
    (towerCoefficient_bounds _ (fun p => (binaryBase_bounds u y p).2) n).2 (by positivity)

/-- The source-retaining unit-prime system cannot have ALL actual Gamma
equalities. This is an exact integer witness, not a density approximation. -/
theorem control_fails_complete_Gamma :
    ∃ N, ArithmeticOperatorFactorialUniqueness.factorialPrefix
      (fun n => (towerCoefficient (retainedBase (10001/20000) 54) n : ℂ)) N ≠
        (Real.log (N.factorial : ℝ) : ℂ) := by
  by_contra hh
  push Not at hh
  obtain ⟨p,hp,hdeleted⟩ := exists_deleted_prime
  have he := congrArg Complex.re (ArithmeticOperatorFactorialUniqueness.mangoldt_unique hh p hp.pos)
  have hpos := Real.log_pos (by exact_mod_cast hp.one_lt : (1 : ℝ)<p)
  simp only [Complex.ofReal_re,towerCoefficient,hp.minFac_eq,retainedBase,hdeleted,
    sub_self,zero_mul,ArithmeticFunction.vonMangoldt_apply_prime hp] at he
  linarith only [he,hpos]

end
end RiemannGaussian.ArithmeticOperatorBinaryEulerControl

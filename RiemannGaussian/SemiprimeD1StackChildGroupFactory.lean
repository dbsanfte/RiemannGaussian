      | 0=>.base (.pop (aux .vertexKey) (.local 15 1) (.local 15 0) (.local 15 0)) -- vertexIncrementClearOld
      | 1=>.call (.copy 13 0) (.local 15 2) -- vertexIncrementCopy
      | 2=>.base (.pop (arithmetic .output) (.local 9 4) (.local 15 2) (.local 15 2)) -- vertexIncrementClearSum
      | 3=>.base (.push (aux .leftPorts) false (.local 15 4)) -- finishAllPorts
      | 4=>.call (.reverse 14 0) (.local 15 5) -- finishAllPortsReverse
      | 5=>.base (.push (aux .orders) false (.local 15 6)) -- finishAllOrders
      | 6=>.call (.reverse 15 0) (.local 15 7) -- finishAllOrdersReverse
      | 7=>.call (.frame 19 0) (.local 15 8) -- finalField0
      | 8=>.call (.frame 20 0) (.local 15 9) -- finalField1
      | 9=>.call (.frame 21 0) (.local 15 10) -- finalField2
      | 10=>.call (.frame 22 0) (.local 15 11) -- finalField3
      | 11=>.call (.frame 23 0) (.local 15 12) -- finalField4
      | 12=>.call (.frame 24 0) (.local 15 13) -- finalField5
      | 13=>.base (.jump (.clear false 0)) -- cleanupSuccess
      | 14=>.base (.jump (.clear true 0)) -- abort
      | 15=>.base (.push (aux .success) true (.local 15 17)) -- accept
      | 16=>.base (.push (aux .success) false (.local 15 17)) -- reject
      | 17=>.base .halt -- halt
      | _=>.base (.jump abort)
    | _=>.base (.jump abort)
  | .clear aborted part=>if retained aborted (role part) then .base (.jump (nextClear aborted part))
      else .base (.pop (role part) (nextClear aborted part) (.clear aborted part) (.clear aborted part))
  | .lookup pc=>SemiprimeD1StackValidationLink.instruction lookup Label.lookup (L.program pc)
  | .rows pc=>SemiprimeD1StackValidationLink.instruction rows Label.rows (R.program pc)
  | .add pc=>SemiprimeD1StackMultiplierLink.instruction arithmetic Label.add (A.code pc)
  | .equal pc=>SemiprimeD1StackMultiplierLink.instruction arithmetic Label.equal (E.code pc)
  | .field site pc=>SemiprimeD1StackMultiplierLink.instruction (fieldStack site) (Label.field site) (F.code pc)
  | .ordinal pc=>SemiprimeD1StackValidationLink.instruction ordinal Label.ordinal (O.program pc)
  | .copy site pc=>SemiprimeD1StackMultiplierLink.instruction (copyStack site) (Label.copy site) (SemiprimeD1StackCopy.code pc)
  | .frame site pc=>SemiprimeD1StackMultiplierLink.instruction (frameStack site) (Label.frame site) (SemiprimeD1StackFrame.code pc)
  | .reverse site pc=>SemiprimeD1StackMultiplierLink.instruction (reverseStack site) (Label.reverse site) (SemiprimeD1StackReverseWord.code pc)
/-- Exactly thirteen physical input words, never decoded host objects in control. -/
structure Inputs where
  /-- Actual physical environment source word. -/
  environment:List Bool
  /-- Actual physical catalogue source word. -/
  catalogue:List Bool
  /-- Actual physical owners source word. -/
  owners:List Bool
  /-- Actual physical factors source word. -/
  factors:List Bool
  /-- Actual physical occurrences source word. -/
  occurrences:List Bool
  /-- Actual physical placements source word. -/
  placements:List Bool
  /-- Actual physical packets source word. -/
  packets:List Bool
  /-- Actual physical colourIndex source word. -/
  colourIndex:List Bool
  /-- Actual physical group source word. -/
  group:List Bool
  /-- Actual physical oldAxes source word. -/
  oldAxes:List Bool
  /-- Actual physical oldPrecision source word. -/
  oldPrecision:List Bool
  /-- Actual physical jetAxis source word. -/
  jetAxis:List Bool
  /-- Actual physical newPrecision source word. -/
  newPrecision:List Bool
/-- No helper, graph, activation, port or success answer is supplied. -/
def input (i:Inputs):Stack→List Bool
  | .inr (.inr (.inr (.inr (.inr k))))=>match k with
    | .environment=>i.environment
    | .catalogue=>i.catalogue
    | .owners=>i.owners
    | .factors=>i.factors
    | .occurrences=>i.occurrences
    | .placements=>i.placements
    | .packets=>i.packets
    | .colourIndex=>i.colourIndex
    | .group=>i.group
    | .oldAxes=>i.oldAxes
    | .oldPrecision=>i.oldPrecision
    | .jetAxis=>i.jetAxis
    | .newPrecision=>i.newPrecision
    | _=>[]
  | _=>[]
/-- Actual prepared source starts before every read/call/field/cleanup. -/
def initial (i:Inputs):C.State Stack Label:=⟨some entry,none,none,input i,[]⟩
/-- Genuine fixed finite115-role compiled machine; producer acquisition is caller work. -/
def machine:Turing.FinTM2:=SemiprimeD1StackCalls.machine (aux .environment) (aux .output) entry program
/-- No unbounded native value, list, decoder, permutation or evaluator enters control. -/
theorem control_finite:Finite machine.σ:=SemiprimeD1StackCalls.control_finite _ _ _ _
/-- All data and actual return alphabets are fixed before every source word. -/
theorem alphabets_finite:∀k,Finite (machine.Γ k):=SemiprimeD1StackCalls.all_alphabets_finite _ _ _ _
end RiemannGaussian.SemiprimeD1StackChildGroupFactory

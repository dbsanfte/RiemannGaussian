/-- Degree and coefficients are checked for EVERY actual intermediate, rather than only the final width.
All diagonal degrees are at most5 and every diagonal coefficient sum is at most1072. -/
theorem diagonal_bound (g:Gate) (x:Nat) (hx:1≤ x) :value g x x x≤1072*x^5:=by
  have h0:1≤ x^5:=Nat.one_le_pow 5 x hx
  have h1:x≤ x^5:=Nat.le_pow (by decide:0<(5:Nat))
  have h2:x^2≤ x^5:=Nat.pow_le_pow_right hx (by decide:2≤5)
  have h3:x^3≤ x^5:=Nat.pow_le_pow_right hx (by decide:3≤5)
  have h4:x^4≤ x^5:=Nat.pow_le_pow_right hx (by decide:4≤5)

set_option Elab.async false
set_option maxRecDepth 32768
set_option synthInstance.maxSize 262144
namespace RiemannGaussian.SemiprimeD1StackRecoveryWidthPolynomial
open SemiprimeD1StackRecoveryWidthCircuit

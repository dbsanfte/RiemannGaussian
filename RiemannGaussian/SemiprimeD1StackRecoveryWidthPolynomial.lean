/-- The physically emitted final width is paid by VALUE, not merely its logarithm. -/
def envelope (a M N:Nat) :Nat:=a+M+N+1
/-- One uniform degree-five value cap covers every gate and every retained intermediate word. -/
theorem value_bound (g:Gate) (a M N:Nat) :value g a M N≤2000*(envelope a M N)^5:=by
  have ha:a≤ envelope a M N:=by unfold envelope;omega
  have hm:M≤ envelope a M N:=by unfold envelope;omega
  have hn:N≤ envelope a M N:=by unfold envelope;omega
  have he:1≤ envelope a M N:=by unfold envelope;omega
  exact (value_mono g ha hm hn).trans ((diagonal_bound g _ he).trans (Nat.mul_le_mul_right _ (by decide:1072≤2000)))
/-- Authoritative original width and physical grid cardinality are exactly the final actual gate specification. -/
theorem last_original (a M:Nat) :value 63 a M (2^(a+1))=SemiprimeD1RecoveryNodeBits.width a M:=by
  rw [last_polynomial]
  rfl
end RiemannGaussian.SemiprimeD1StackRecoveryWidthPolynomial

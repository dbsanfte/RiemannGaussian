/-- Proof value of a static physical original/cache/earlier gate wire. -/
def sourceValue (a M N:Nat) :Source→Nat
  | .a=>a | .m=>M | .n=>N | .reg g=>value g a M N
/-- Every one of the64 actual source gates has exactly its original fixed arithmetic meaning. -/
theorem gate_formula (g:Gate) (a M N:Nat) :value g a M N=match node g with
    | .literal k=>literalValue k | .add l r=>sourceValue a M N l+sourceValue a M N r
    | .mul l r=>sourceValue a M N l*sourceValue a M N r:=by
  fin_cases g <;> rfl
/-- The exact final static gate is the authoritative original width polynomial, before substitution N=2^(a+1). -/
theorem last_polynomial (a M N:Nat) :value 63 a M N=SemiprimeD1RecoveryNodeBits.widthPolynomial a M N:=by
  rfl
/-- Every intermediate polynomial has nonnegative coefficients and is monotone in all three original dimensions. -/
theorem value_mono (g:Gate) {a M N A B D:Nat} (ha:a≤ A) (hM:M≤ B) (hN:N≤ D) :
    value g a M N≤ value g A B D:=by
  fin_cases g
  · change 1≤1
    exact le_rfl
  · change 2≤2
    exact le_rfl
  · change 3≤3
    exact le_rfl
  · change 4≤4
    exact le_rfl
  · change 10≤10
    exact le_rfl
  · change 20≤20
    exact le_rfl
  · change (a+1)≤(A+1)
    gcongr
  · change (4*M)≤(4*B)
    gcongr
  · change (N*(4*M))≤(D*(4*B))

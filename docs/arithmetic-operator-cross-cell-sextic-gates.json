  "gates": [
    {
      "name": "full-prefix closure of an earlier row space",
      "proved": [
        "Over any ring, a constant-containing submodule invariant under all prefix cutoffs is top.",
        "Exact interval restriction and finite cell decomposition."
      ],
      "scope": "A proper earlier-row space only; the final full-rank space is already top. Native restricted/row-dependent cutoff families need not satisfy this hypothesis."
    },
    {
      "name": "adjacent quadratic norm values",
      "proved": [
        "(t+2)f(t)=t*f(t+1)+4 for f(t)=3t^2+3t+2.",
        "Adjacent gcd is 4 at t mod 4 =1, and 2 otherwise.",
        "Every prime-power phase retained: growing common-divisor packet is exactly T log(2) phi(2)+floor((T+2)/4) log(2) phi(4).",
        "After exact density centering, norm<=log(2), and normalization by X^beta tends to zero for every beta>0."
      ],
      "scope": "This adjacent common-divisor statistic loses the positive-power zero source. The full polynomial prime-divisor packet, nonadjacent/growing correlations and determinant carry-layer bridge remain open."
    },
    {
      "name": "native sextic generic norm rate",
      "proved": [
        "Conditional rational rate E(d)=max(2/9-5d/6,107/576-d/3) on 0<=d<=1/6.",
        "E(d)<3/16 iff d>1/24; shallow deficit exactly 5/144.",
        "Even a counterfactual pure quadratic ledger retains the mark cost and only has 1/96 shallow margin."
      ],
      "scope": "H=V=1, maximal physical mark; assumes common separated coefficients and the stated norm input. No literature analytic theorem imported, no native signed lower/upper bound proved."
    },
    {
      "name": "native coefficient versus sextic resonant witness",
      "existing_checked_identity": "alpha_native(I)=mu(I)*g_ray(I)*conj(gamma_1(I))",
      "paper_level_conclusion": "On common fixed ray/profile the Gauss overlap is a weighted Mobius sum. Its Mellin transform is a finite reciprocal-Hecke combination. Retaining the numerator restores a growing-conductor reciprocal-Hecke row.",
      "scope": "Free-vector operator norms do not bound one prescribed vector. Small overlap with one witness does not control the complementary operator. No fixed-power native saving or source exclusion follows."
    }
  ],

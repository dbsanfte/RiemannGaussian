    {
      "name": "compressed extension",
      "conclusion": "Rank-eight/five-coordinate Boolean grid passes exact finite rank test; no uniform anisotropic interpolation or zeta-to-Frobenius source bridge."
    },
    {
      "name": "strict monic Gauss lift",
      "conclusion": "The natural strict lower-weight cubic relation eliminates all Gauss exponents >=3 from greedy rows; this coordinate cannot produce p>=3 floor extraction. Scope is this particular lift only."
    },
    {
      "name": "growing conductor",
      "conclusion": "A c/log(D) gap at D=X^kappa does not itself give a fixed power saving in X."
    }

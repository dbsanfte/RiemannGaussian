    `OAI.Algorithms.SubexponentialSAT.SubexpUnaryRowProgram,
    `OAI.Algorithms.SubexponentialSAT.SubexpUnaryTableCorrectness,
    `OAI.Algorithms.SubexponentialSAT.SubexpVectorEnumeration,
    `OAI.Algorithms.SubexponentialSAT.SubexpVertexIndexProgram,
    `OAI.Algorithms.SubexponentialSAT.SubexpVertexPairComplexity,
    `OAI.Algorithms.SubexponentialSAT.SubexpVertexPairProgram,
    `OAI.Algorithms.SubexponentialSAT.SubexpWeightCode,
    `OAI.Algorithms.SubexponentialSAT.SubspaceDimension,
    `OAI.Algorithms.SubexponentialSAT.Sunflower,
    `OAI.Algorithms.SubexponentialSAT.SunflowerBranch,
    `OAI.Algorithms.SubexponentialSAT.SymbolicCost,
    `OAI.Algorithms.SubexponentialSAT.TableInterpolation,
    `OAI.Algorithms.SubexponentialSAT.TruncatedConvolution,
    `OAI.Algorithms.SubexponentialSAT.TruncatedInverse,
    `OAI.Algorithms.SubexponentialSAT.Truncation,
    `OAI.Algorithms.SubexponentialSAT.TypeDistribution,
    `OAI.Algorithms.SubexponentialSAT.Types,
    `OAI.Algorithms.SubexponentialSAT.UnaryForPrograms,
    `OAI.Algorithms.SubexponentialSAT.Variance,
    `OAI.Algorithms.SubexponentialSAT.WeightedSupport,
    `OAI.Algorithms.SubexponentialSAT.WorkspaceCleanupProgram].foldl (fun s n => s.insert n) {}
  let env ← getEnv
  let mut modules : Nat := 0
  let mut declarations : Nat := 0
  let mut theorems : Nat := 0
  let mut rows : Array Json := #[]
  for h : i in [0:env.header.moduleNames.size] do
    let moduleName := env.header.moduleNames[i]
    unless selected.contains moduleName do continue
    modules := modules+1
    let mut count : Nat := 0
    let mut proofs : Nat := 0
    for ci in env.header.moduleData[i]!.constants do
      count := count+1
      if ci.isAxiom then throwError "Source-defined axiom: {ci.name}"
      if ci.isTheorem then proofs := proofs+1
      for ax in (← Lean.collectAxioms ci.name) do
        unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
          throwError "Unexpected transitive axiom in {ci.name}: {ax}"
    declarations := declarations+count
    theorems := theorems+proofs
    rows := rows.push (Json.mkObj [("module", toJson moduleName.toString),
      ("declarations", toJson count), ("theorems", toJson proofs)])
    if modules % 128 == 0 then
      logInfo m!"Audited {modules} source modules, {declarations} declarations."
  unless modules == 2569 do
    throwError "Wrong source-module count: {modules}, expected 2569"
  unless theorems > 0 do throwError "No source theorem checked"
  let report := Json.mkObj [("status", toJson "PASS"),
    ("source_modules", toJson modules), ("declarations", toJson declarations),
    ("theorems", toJson theorems), ("per_module", Json.arr rows)]
  liftIO (IO.FS.writeFile "/tmp/semiprime-layout-assembly-20261026/external-every-declaration.json" report.pretty)
  logInfo m!"PASS: {modules} source modules, {declarations} declarations, {theorems} theorem constants; standard axioms only."

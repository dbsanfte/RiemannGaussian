import RiemannGaussian
import OpenAISemiprime
import Lean.Util.CollectAxioms

open Lean Elab Command
run_cmd do
  let env ← getEnv
  let expected : List Name := [`OpenAISemiprime.Algorithms.SubexponentialSAT.SubexpRowInterpolation, `OpenAISemiprime.Algorithms.SubexponentialSAT.LeanCompat, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutSignatureBound, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutExactBuckets, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutPullback, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutRowSelection, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutRankUniversal, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutUniversal, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutNumeratorBridge, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.SpectralRank, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.SpectralTail, `OpenAISemiprime.Algorithms.SubexponentialSAT.Subexp.TailInterval, `OpenAISemiprime.Algorithms.SubexponentialSAT.SubexpSwapMultiplicity, `OpenAISemiprime.Algorithms.SubexponentialSAT.Subexp.SpectralRank, `OpenAISemiprime.Algorithms.SubexponentialSAT.Subexp.TensorSpectrum, `OpenAISemiprime.Algorithms.SubexponentialSAT.SpectralRank, `OpenAISemiprime.Algorithms.SubexponentialSAT.BinomialInterpolation, `OpenAISemiprime.Algorithms.SubexponentialSAT.MatrixSupport, `OpenAISemiprime.Algorithms.SubexponentialSAT.LocalSpectrum, `OpenAISemiprime.Algorithms.SubexponentialSAT.Types, `OpenAISemiprime.Algorithms.SubexponentialSAT.BinomialMatrix, `OpenAISemiprime.Algorithms.SubexponentialSAT.LayoutParameters, `OpenAISemiprime.Algorithms.SubexponentialSAT.ParameterOrder, `OpenAISemiprime.Algorithms.SubexponentialSAT.BinomialMultiplicity, `OpenAISemiprime.Algorithms.SubexponentialSAT.Subexp.MatrixSupport, `OpenAISemiprime.Algorithms.SubexponentialSAT.MulticolorTypes, `OpenAISemiprime.Algorithms.SubexponentialSAT.SlotAssignment, `OpenAISemiprime.Algorithms.SubexponentialSAT.Incidence, `OpenAISemiprime.Algorithms.SubexponentialSAT.Factor, `OpenAISemiprime.Algorithms.SubexponentialSAT.Subexp.LocalSpectrum, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.SpectralBinomial, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutScaledMatrices, `OpenAISemiprime.Algorithms.SubexponentialSAT.SubexpAnnihilation, `OpenAISemiprime.Algorithms.SubexponentialSAT.Subexp.SubspaceDimension, `OpenAISemiprime.Algorithms.SubexponentialSAT.SubspaceDimension, `OpenAISemiprime.Algorithms.SubexponentialSAT.Annihilation, `OpenAISemiprime.Algorithms.SubexponentialSAT.RowInterpolation, `OpenAISemiprime.Algorithms.SubexponentialSAT.TableInterpolation, `OpenAISemiprime.Algorithms.SubexponentialSAT.LiftRing, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutNumeratorBounds, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutCoefficientBounds, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutNumerator, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutIndexed, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutInterface, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutRankBlocks, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutRankCounts, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutBlocks, `OpenAISemiprime.Algorithms.SubexponentialSAT.BlockPacking, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutHeadPullback, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.LayoutRank, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.PackingConcrete, `OpenAISemiprime.Algorithms.SubexponentialSAT.Subexp.ConstructivePacking, `OpenAISemiprime.Algorithms.SubexponentialSAT.SubexpBlockPacking, `OpenAISemiprime.Algorithms.SubexponentialSAT.DirectSums, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.PackingTheorem, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.PackingAlgorithm, `OpenAISemiprime.Algorithms.SubexponentialSAT.LocalExpectation, `OpenAISemiprime.Algorithms.SubexponentialSAT.TypeDistribution, `OpenAISemiprime.Algorithms.SubexponentialSAT.ConditionalExpectation, `OpenAISemiprime.Algorithms.SubexponentialSAT.Variance, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.PackingSelection, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.PackingWords, `OpenAISemiprime.Algorithms.SubexponentialSAT.SqrtLog.PackingVariance]
  let mut audited : Nat := 0
  let mut declarations : Nat := 0
  let mut theorems : Nat := 0
  for h : i in [0:env.header.moduleNames.size] do
    let moduleName := env.header.moduleNames[i]
    unless moduleName ∈ expected do continue
    for ci in env.header.moduleData[i]!.constants do
      declarations := declarations + 1
      if ci.isAxiom then throwError "custom axiom: {ci.name}"
      if ci.isTheorem then theorems := theorems + 1
      for ax in (← Lean.collectAxioms ci.name) do
        unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
          throwError "disallowed transitive axiom in {ci.name}: {ax}"
    audited := audited + 1
  unless audited == expected.length do throwError "audited {audited}/{expected.length} modules"
  logInfo m!"PINNED_LAYOUT_AUDIT modules={audited}, declarations={declarations}, theorems={theorems}, standard_axioms_only=true"

import RiemannGaussian.SemiprimeSourceProgramBits
import RiemannGaussian.SemiprimeReportPolynomialGrowth

/-! # Concrete store and instruction payloads of the source simulator
All states are generated by the actual physical step. Counts conservatively
retain every complete store version, including duplicate payloads. Arithmetic
primitive scratch and a full pointer/tape encoding remain separate obligations.
-/
set_option autoImplicit false
set_option maxHeartbeats 1200000
namespace RiemannGaussian.SemiprimeSourceProgramStorage
open SemiprimeRationalBits SemiprimeSourceMemoryBits SemiprimeSourceProgramBits
open SemiprimeReportPolynomialGrowth

/-- Sign plus the two physical magnitude-word payloads. -/
def wordCells (x : RationalWord) : ℕ := x.numerator.magnitude.length+x.denominator.length+1
/-- All physical data cells in one stored finite memory version. -/
def memoryCells (memory : List RationalWord) : ℕ := (memory.map wordCells).sum
/-- A constant-size opcode/tag allowance plus both physical address words. -/
def instructionCells (i : Instruction) : ℕ := i.left.length+i.right.length+6
/-- The literal instruction bank's payload and per-instruction tags. -/
def codeCells (code : List Instruction) : ℕ := (code.map instructionCells).sum

/-- Width bounds imply a concrete memory payload bound. -/
theorem memoryCells_bound (memory : List RationalWord) (W : ℕ)
    (h : ∀ x∈memory,Width x W) : memoryCells memory ≤ memory.length*(2*W+1) := by
  induction memory with
  | nil => simp [memoryCells]
  | cons x xs ih =>
    have hx := h x List.mem_cons_self
    have ht := ih (fun y hy => h y (List.mem_cons_of_mem x hy))
    simp only [memoryCells,List.map_cons,List.sum_cons,List.length_cons] at ⊢
    change wordCells x+memoryCells xs ≤ _
    unfold wordCells
    rcases hx with ⟨hn,hd⟩
    nlinarith

/-- No instruction descriptor has an opaque unbounded address field. -/
theorem codeCells_bound (code : List Instruction) (B : ℕ)
    (h : ∀ i∈code,i.left.length ≤ B ∧ i.right.length ≤ B) :
    codeCells code ≤ code.length*(2*B+6) := by
  induction code with
  | nil => simp [codeCells]
  | cons i code ih =>
    have hi := h i List.mem_cons_self
    have ht := ih (fun j hj => h j (List.mem_cons_of_mem i hj))
    simp only [codeCells,List.map_cons,List.sum_cons,List.length_cons] at ⊢
    change instructionCells i+codeCells code ≤ _
    unfold instructionCells
    nlinarith

/-- Proof view of the initial state and every actual post-instruction store. -/
def stores (template : List Bool) : List Instruction → List RationalWord → List (List RationalWord)
  | [],memory => [memory]
  | i::code,memory => memory::stores template code (step template i memory).memory

/-- There is one real store version per instruction plus the initial one. -/
theorem stores_length (template : List Bool) (code : List Instruction) (memory : List RationalWord) :
    (stores template code memory).length=code.length+1 := by
  induction code generalizing memory with
  | nil => simp [stores]
  | cons i code ih => simp only [stores,List.length_cons,ih]

/-- Every recorded state has bounded width and actual register count, derived from the
input and literal instruction traversal rather than an assumed reachable-state cap. -/
theorem stores_bound (template : List Bool) (code : List Instruction) (memory : List RationalWord)
    (h : ∀ x∈memory,Width x template.length) :
    ∀ state∈stores template code memory,
      state.length ≤ memory.length+code.length ∧ ∀ x∈state,Width x template.length := by
  induction code generalizing memory with
  | nil =>
    intro state hs
    simp only [stores,List.mem_singleton] at hs
    subst state
    exact ⟨by simp,h⟩
  | cons i code ih =>
    intro state hs
    simp only [stores,List.mem_cons] at hs
    rcases hs with rfl | hs
    · exact ⟨by simp only [List.length_cons]; omega,h⟩
    · have ht := ih (step template i memory).memory (step_width template i memory h) state hs
      rw [step_length] at ht
      exact ⟨by simpa only [List.length_cons,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using ht.1,ht.2⟩

/-- The terminal executed result is a genuine state in the trace, not an abstract envelope. -/
theorem run_mem_stores (template : List Bool) (code : List Instruction) (memory : List RationalWord) :
    (run template code memory).memory∈stores template code memory := by
  induction code generalizing memory with
  | nil => simp [run,stores]
  | cons i code ih => exact List.mem_cons_of_mem _ (ih (step template i memory).memory)

/-- A literal fixed bound for all persistent store versions, keeping every copied cell. -/
theorem all_store_cells (template : List Bool) (code : List Instruction) (memory : List RationalWord)
    (h : ∀ x∈memory,Width x template.length) :
    ((stores template code memory).map memoryCells).sum ≤
      (code.length+1)*(memory.length+code.length)*(2*template.length+1) := by
  have each (state : List RationalWord) (hs : state∈stores template code memory) :
      memoryCells state ≤ (memory.length+code.length)*(2*template.length+1) := by
    have hb := stores_bound template code memory h state hs
    exact (memoryCells_bound state template.length hb.2).trans (Nat.mul_le_mul_right _ hb.1)
  have sum_bound (states : List (List RationalWord)) (C : ℕ)
      (hc : ∀ state∈states,memoryCells state ≤ C) :
      (states.map memoryCells).sum ≤ states.length*C := by
    induction states with
    | nil => simp
    | cons state states ih =>
      have ht := ih (fun a ha => hc a (List.mem_cons_of_mem state ha))
      have hh := hc state List.mem_cons_self
      simp only [List.map_cons,List.sum_cons,List.length_cons]
      nlinarith
  have hs := sum_bound (stores template code memory)
    ((memory.length+code.length)*(2*template.length+1)) each
  simpa only [stores_length,Nat.mul_assoc] using hs

/-- Actual program execution plus all persistent stores has fixed polynomial growth
in original register/code/payload/address bounds. Primitive scratch is not counted twice. -/
theorem resource_polynomial : ∃ C k : ℕ,∀ M T W B S,
    M ≤ S → T ≤ S → W ≤ S → B ≤ S →
    T*(stepBudget (M+T) W B+3)+1+(T+1)*(M+T)*(2*W+1)+T*(2*B+6) ≤ C*(S+1)^k := by
  have hp : Bound (fun S => S*(stepBudget (S+S) S S+3)+1+
      (S+1)*(S+S)*(2*S+1)+S*(2*S+6)) := by
    unfold stepBudget
    boundArithmetic
  obtain ⟨C,k,h⟩ := hp
  refine ⟨C,k,?_⟩
  intro M T W B S hM hT hW hB
  apply le_trans _ (h S)
  unfold stepBudget
  dsimp only
  gcongr

end RiemannGaussian.SemiprimeSourceProgramStorage

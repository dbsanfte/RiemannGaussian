import RiemannGaussian.SemiprimeMaterializedSourceUniversal
import RiemannGaussian.SemiprimeFiniteEnumerations

/-! # Executed finite-list constructors for source enumeration
The report retains every recursive constructor, callback, cell and coordinate
copy. It is a scalar/list/coordinate-access trace, not a primitive bit clock.
-/
set_option autoImplicit false
set_option maxHeartbeats 1600000
namespace RiemannGaussian.SemiprimePaidFiniteEnumerationLists
open scoped BigOperators
open OAI.Algorithms.SubexponentialSAT
open MulticolorTypes Subexp.ConstructivePacking
open SemiprimeMaterializedSourceUniversal

/-- Ascending finite indices generated by literal recursive successor maps. -/
def fin : (n : ℕ) → Run (List (Fin n))
  | 0 => ⟨[],1⟩
  | n+1 =>
      let old := fin n
      let mapped := collect (fun i : Fin n => (⟨i.succ,1⟩ : Run (Fin (n+1)))) old.value
      ⟨0::mapped.value,old.work+mapped.work+2⟩

@[simp] theorem fin_value (n : ℕ) : (fin n).value=List.finRange n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [fin,collect_value,ih,List.finRange_succ]

theorem fin_work (n : ℕ) : (fin n).work≤3*(n+1)^2 := by
  induction n with
  | zero => norm_num [fin]
  | succ n ih =>
    have hm := collect_work (fun i : Fin n => (⟨i.succ,1⟩ : Run (Fin (n+1)))) (fin n).value 1
      (fun _ _ => le_rfl)
    rw [fin_value,List.length_finRange] at hm
    simp only [fin,fin_value]
    nlinarith

/-- Literal Cartesian product, including all pair cells and concatenation traversal. -/
def product {α β : Type*} : List α → List β → Run (List (α × β))
  | [],_ => ⟨[],1⟩
  | a::as,bs =>
      let first := collect (fun b => (⟨(a,b),1⟩ : Run (α × β))) bs
      let tail := product as bs
      ⟨first.value++tail.value,first.work+tail.work+first.value.length+2⟩

theorem product_value {α β : Type*} (as : List α) (bs : List β) :
    (product as bs).value=as.product bs := by
  induction as with
  | nil => rfl
  | cons a as ih => simp only [product,collect_value,ih]; rfl

theorem product_work {α β : Type*} (as : List α) (bs : List β) :
    (product as bs).work≤as.length*(4*bs.length+3)+1 := by
  induction as with
  | nil => simp [product]
  | cons a as ih =>
    have hm := collect_work (fun b => (⟨(a,b),1⟩ : Run (α × β))) bs 1 (fun _ _ => le_rfl)
    simp only [product,collect_value,List.length_map,List.length_cons]
    nlinarith

/-- Tagged sum in the original left-before-right order, paying both maps and append. -/
def sum {α β : Type*} (as : List α) (bs : List β) : Run (List (α ⊕ β)) :=
  let left := collect (fun a => (⟨Sum.inl a,1⟩ : Run (α ⊕ β))) as
  let right := collect (fun b => (⟨Sum.inr b,1⟩ : Run (α ⊕ β))) bs
  ⟨left.value++right.value,left.work+right.work+left.value.length+2⟩

theorem sum_value {α β : Type*} (as : List α) (bs : List β) :
    (sum as bs).value=as.map Sum.inl++bs.map Sum.inr := by simp only [sum,collect_value]

theorem sum_work {α β : Type*} (as : List α) (bs : List β) :
    (sum as bs).work≤4*(as.length+bs.length)+4 := by
  have hl := collect_work (fun a => (⟨Sum.inl a,1⟩ : Run (α ⊕ β))) as 1 (fun _ _ => le_rfl)
  have hr := collect_work (fun b => (⟨Sum.inr b,1⟩ : Run (α ⊕ β))) bs 1 (fun _ _ => le_rfl)
  simp only [sum,collect_value,List.length_map]
  nlinarith

/-- Flatten a list-producing computation with every child acquisition and append paid. -/
def flat {α β : Type*} (f : α → Run (List β)) : List α → Run (List β)
  | [] => ⟨[],1⟩
  | a::as =>
      let first := f a
      let tail := flat f as
      ⟨first.value++tail.value,first.work+tail.work+first.value.length+2⟩

theorem flat_value {α β : Type*} (f : α → Run (List β)) (as : List α) :
    (flat f as).value=as.flatMap (fun a => (f a).value) := by
  induction as with
  | nil => rfl
  | cons a as ih => simp only [flat,ih,List.flatMap_cons]

theorem flat_work {α β : Type*} (f : α → Run (List β)) (as : List α) (B L : ℕ)
    (hb : ∀ a∈as, (f a).work≤B) (hl : ∀ a∈as, (f a).value.length≤L) :
    (flat f as).work≤as.length*(B+L+2)+1 := by
  induction as with
  | nil => simp [flat]
  | cons a as ih =>
    have hba := hb a (by simp)
    have hla := hl a (by simp)
    have ht := ih (fun a ha => hb a (by simp [ha])) (fun a ha => hl a (by simp [ha]))
    simp only [flat,List.length_cons]
    nlinarith

variable {r q : ℕ} [NeZero r]

/-- Materialize EVERY coordinate of a candidate word before exposing its function.
The returned function reads the cached array; no growing cons-chain is evaluated later. -/
def copyWord (coordinates : List (Fin q)) (word : Word r q) : Run (Word r q) :=
  let out := collect (fun i => (⟨word i,2⟩ : Run (Fin r))) coordinates
  let cells := out.value.toArray
  ⟨fun i => (cells[i.val]?).getD 0,out.work+out.value.length+2⟩

theorem copyWord_value (word : Word r q) :
    (copyWord (List.finRange q) word).value=word := by
  funext i
  simp [copyWord,collect_value]

theorem copyWord_work (coordinates : List (Fin q)) (word : Word r q) :
    (copyWord coordinates word).work≤5*coordinates.length+3 := by
  have h := collect_work (fun i => (⟨word i,2⟩ : Run (Fin r))) coordinates 2 (fun _ _ => le_rfl)
  simp only [copyWord,collect_value,List.length_map]
  omega

/-- Head-major word enumeration, copying every new coordinate vector to a real array. -/
def words (r : ℕ) [NeZero r] : (q : ℕ) → Run (List (Word r q))
  | 0 => ⟨[fun i => Fin.elim0 i],1⟩
  | q+1 =>
      let tails := words r q
      let heads := fin r
      let pairs := product heads.value tails.value
      let coordinates := fin (q+1)
      let out := collect (fun p => copyWord coordinates.value (Fin.cons p.1 p.2)) pairs.value
      ⟨out.value,tails.work+heads.work+pairs.work+coordinates.work+out.work+4⟩

/-- Exact old ordering, with extensionally identical functions backed by paid coordinate arrays. -/
theorem words_value (r q : ℕ) [NeZero r] : (words r q).value=(SemiprimeFiniteEnumerations.words r q).values := by
  induction q with
  | zero => rfl
  | succ q ih =>
    simp only [words,collect_value,product_value,fin_value,ih]
    rw [show (fun p : Fin r × Word r q =>
      (copyWord (List.finRange (q+1)) (Fin.cons p.1 p.2)).value)=
        (fun p => Fin.cons p.1 p.2) by funext p; exact copyWord_value _]
    rfl

@[simp] theorem words_length (r q : ℕ) [NeZero r] : (words r q).value.length=r^q := by
  rw [words_value,SemiprimeFiniteEnumerations.words_length]

/-- One stage envelope, expressed only in explicit original finite dimensions. -/
def wordStage (r Q : ℕ) : ℕ :=
  3*(r+1)^2+(r*(4*r^Q+3)+1)+3*(Q+1)^2+(r*r^Q*(5*Q+5)+1)+4

/-- A polynomial envelope in word alphabet size, coordinate width and color count. -/
def wordsBudget (r Q : ℕ) : ℕ := 1+Q*wordStage r Q

/-- All earlier stages fit the target coordinate/alphabet envelope, not an exponential search. -/
theorem words_work_le (r q Q : ℕ) [NeZero r] (hq : q≤Q) :
    (words r q).work≤1+q*wordStage r Q := by
  induction q with
  | zero => simp [words]
  | succ q ih =>
    have hq' : q≤Q := by omega
    have ht := ih hq'
    have hh := fin_work r
    have hc := fin_work (q+1)
    have hp := product_work (fin r).value (words r q).value
    rw [fin_value,List.length_finRange,words_length] at hp
    have ho := collect_work
      (fun p : Fin r × Word r q => copyWord (fin (q+1)).value (Fin.cons p.1 p.2))
      (product (fin r).value (words r q).value).value (5*(q+1)+3) (by
        intro p _
        have h := copyWord_work (fin (q+1)).value (Fin.cons p.1 p.2)
        simpa only [fin_value,List.length_finRange] using h)
    have hlength : (product (fin r).value (words r q).value).value.length=r*r^q := by
      rw [product_value,fin_value]
      change ((List.finRange r) ×ˢ (words r q).value).length=r*r^q
      rw [List.length_product,List.length_finRange,words_length]
    rw [hlength] at ho
    simp only [fin_value] at ho
    have hr : 1≤r := NeZero.one_le
    have hpow : r^q≤r^Q := Nat.pow_le_pow_right hr hq'
    have hpm : r*(4*r^q+3)+1≤r*(4*r^Q+3)+1 := by gcongr
    have hcm : 3*(q+1+1)^2≤3*(Q+1)^2 := by gcongr
    have hom : r*r^q*(5*(q+1)+3+2)+1≤r*r^Q*(5*Q+5)+1 :=
      Nat.add_le_add_right (Nat.mul_le_mul (Nat.mul_le_mul_left r hpow) (by omega)) 1
    have hstage : (fin r).work+(product (fin r).value (words r q).value).work+
        (fin (q+1)).work+(collect
          (fun p : Fin r × Word r q => copyWord (fin (q+1)).value (Fin.cons p.1 p.2))
          (product (fin r).value (words r q).value).value).work+4≤wordStage r Q := by
      simp only [fin_value]
      unfold wordStage
      omega
    simp only [words]
    nlinarith

theorem words_work (r q : ℕ) [NeZero r] : (words r q).work≤wordsBudget r q :=
  words_work_le r q q le_rfl

end RiemannGaussian.SemiprimePaidFiniteEnumerationLists
